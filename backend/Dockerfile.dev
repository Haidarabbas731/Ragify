# ── Dev image — includes dev dependencies (milvus-lite, etc.) ────────────────
# Used by docker-compose.yml for local development only.
# Production uses Dockerfile (--no-dev, leaner image).

# ── Stage 1: dependency builder ──────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./

# Install ALL deps including dev (milvus-lite lives here)
RUN uv sync --frozen

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1001 appgroup && useradd -u 1001 -g appgroup -s /bin/bash appuser

WORKDIR /app

COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv
COPY --from=builder /app/.venv /app/.venv

ENV PATH="/app/.venv/bin:$PATH"

COPY --chown=appuser:appgroup . .

# Create writable directories for Milvus Lite data and local document storage
RUN mkdir -p /app/milvus_data /app/storage && chown -R appuser:appgroup /app/milvus_data /app/storage

RUN chmod +x start.sh

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${PORT:-8000}/api/v1/health')" || exit 1

CMD ["./start.sh"]
