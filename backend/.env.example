# Application
APP_NAME=Ragify
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
# Development (Docker): Use localhost
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/knowledge_base
# Production (Cloud): Uncomment and add your cloud database URL
# DATABASE_URL=postgresql+asyncpg://user:password@your-cloud-db-host:5432/knowledge_base
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
# Development (Docker): Use localhost
REDIS_URL=redis://localhost:6379/0
# Production (Cloud): Uncomment and add your cloud Redis URL
# REDIS_URL=rediss://default:password@your-cloud-redis-host:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Milvus Configuration
# Development (Local Docker): Use http://localhost:19530
# Production (Zilliz Cloud): Use https://your-instance.serverless.region.cloud.zilliz.com
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowledge_base
MILVUS_TOKEN=

# Backblaze B2
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=1024

# File Upload
MAX_FILE_SIZE_MB=50
MAX_UPLOAD_BATCH=10
ALLOWED_FILE_TYPES=pdf,docx,txt,md

# Text Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Chat
CONVERSATION_HISTORY_LIMIT=5

# Storage Quotas
STORAGE_QUOTA_DEFAULT=1073741824

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO

# Invite-Only Registration
INVITE_ONLY=true

# CORS
FRONTEND_URL=http://localhost:5173

# Email (Resend for password reset and notifications)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Ragify
