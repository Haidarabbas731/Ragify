# Environment variables for docker-compose.dokploy.yml
#
# Set these in the Dokploy project's "Environment" tab — do NOT commit a real
# .env file. This is a reference of every variable the stack needs.
#
# postgres/redis/milvus service hosts below are the internal Docker service
# names from docker-compose.dokploy.yml — leave them as-is.

# ── Postgres container ───────────────────────────────────────────────────────
POSTGRES_DB=knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── App → Postgres ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:change-me-to-a-strong-password@postgres:5432/knowledge_base
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── App → Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App → Milvus (standalone, internal only — do not expose 19530 publicly) ──
# VECTOR_DB_URI is hardcoded to http://milvus:19530 in docker-compose.dokploy.yml
MILVUS_COLLECTION=knowledge_base
VECTOR_DB_TOKEN=

# ── File Storage (Backblaze B2) ────────────────────────────────────────────────
# STORAGE_BACKEND is hardcoded to b2 in docker-compose.dokploy.yml
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=1024

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_UPLOAD_BATCH=10
ALLOWED_FILE_TYPES=pdf,docx,txt,md

# ── Text Chunking ─────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── RAG Chat ──────────────────────────────────────────────────────────────────
CONVERSATION_HISTORY_LIMIT=5

# ── Storage Quotas ────────────────────────────────────────────────────────────
STORAGE_QUOTA_DEFAULT=1073741824

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ── Invite-Only Registration ──────────────────────────────────────────────────
INVITE_ONLY=true

# ── Seed Admin (created on first run if not exists) ──────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your deployed frontend's origin (e.g. https://ragify.vercel.app)
FRONTEND_URL=https://your-frontend-domain.example.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Ragify

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
